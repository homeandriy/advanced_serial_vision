QWidget { background: #2b2b2b; color: #e8e8e8; }
QLineEdit, QTextEdit, QComboBox, QSpinBox, QTableWidget, QDateEdit, QDateTimeEdit { background: #333333; color: #eeeeee; border: 1px solid #545454; border-radius: 3px; padding: 3px; }
QTextEdit#recognitionResult { font-size: 16px; }
QLabel#updateStepActive { font-weight: bold; color: #8ee6ae; }
QLabel#updateStepDone { color: #a1bca8; }
QPushButton { background: #3b3b3b; border: 1px solid #555555; border-radius: 3px; padding: 5px 8px; }
QPushButton:hover { background: #4b4b4b; }
QPushButton:pressed, QToolButton:pressed { background: #5a6774; }
QPushButton:disabled, QToolButton:disabled { color: #a0a0a0; background: #343434; border-color: #525252; }
QPushButton:focus, QToolButton:focus, QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTableWidget:focus { border: 2px solid #80bfff; }
QToolButton:checked { background: #29445f; border: 2px solid #80bfff; }
QLabel#settingsStatus[state="dirty"] { color: #ffd38a; font-weight: bold; }
QLabel#recognitionStatus { color: #c6d9eb; }
QHeaderView::section { background: #3b3b3b; color: #eeeeee; padding: 4px; border: 1px solid #555555; }
QTabBar::tab { background: #333333; color: #e8e8e8; padding: 6px 10px; }
QTabBar::tab:selected { background: #454545; }
